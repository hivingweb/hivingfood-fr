{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "hivingfood.fr"
        }
      ],
      "destination": "https://www.hivingfood.fr/:path*",
      "permanent": true
    },
    {
      "source": "/agence-influence-food",
      "destination": "/food/agence.html",
      "permanent": true
    },
    {
      "source": "/agence-influence-food/",
      "destination": "/food/agence.html",
      "permanent": true
    },
    {
      "source": "/influenceurs-food",
      "destination": "/food/talents.html",
      "permanent": true
    },
    {
      "source": "/influenceurs-food/",
      "destination": "/food/talents.html",
      "permanent": true
    },
    {
      "source": "/studio-food",
      "destination": "/food/studios.html",
      "permanent": true
    },
    {
      "source": "/studio-food/",
      "destination": "/food/studios.html",
      "permanent": true
    },
    {
      "source": "/campagnes-influence-food",
      "destination": "/food/campagnes.html",
      "permanent": true
    },
    {
      "source": "/campagnes-influence-food/",
      "destination": "/food/campagnes.html",
      "permanent": true
    },
    {
      "source": "/evenementiel",
      "destination": "/food/evenementiel.html",
      "permanent": true
    },
    {
      "source": "/evenementiel/",
      "destination": "/food/evenementiel.html",
      "permanent": true
    },
    {
      "source": "/preview-header",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/preview-header/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v3",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v3/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/campagnes/:slug(metro|president|picard)",
      "destination": "/food/campagnes/:slug/",
      "permanent": true
    },
    {
      "source": "/projects(/.*)?",
      "destination": "/food/campagnes.html",
      "permanent": true
    },
    {
      "source": "/case-study(/.*)?",
      "destination": "/food/campagnes.html",
      "permanent": true
    },
    {
      "source": "/blogs(/.*)?",
      "destination": "/food/blog.html",
      "permanent": true
    },
    {
      "source": "/about(/.*)?",
      "destination": "/food/agence.html",
      "permanent": true
    },
    {
      "source": "/expertise(/.*)?",
      "destination": "/food/agence.html",
      "permanent": true
    },
    {
      "source": "/talent(/.*)?",
      "destination": "/food/talents.html",
      "permanent": true
    },
    {
      "source": "/contact(/.*)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/reserver(/.*)?",
      "destination": "https://hivingstudio.fr/pages/devis.html",
      "permanent": true
    },
    {
      "source": "/200.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/marketing-influence-food.html",
      "destination": "/blog/marketing-influence-food",
      "permanent": true
    },
    {
      "source": "/blog/marketing-influence-food/",
      "destination": "/blog/marketing-influence-food",
      "permanent": true
    },
    {
      "source": "/:file(.*\\.(?:mp4|glb))",
      "destination": "https://xy8wkkceax6fodpg.public.blob.vercel-storage.com/hivingfood-fr/:file",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://www.googletagmanager.com https://*.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com https://www.facebook.com https://*.public.blob.vercel-storage.com; media-src 'self' blob: https://*.public.blob.vercel-storage.com; connect-src 'self' https://pmrqrbjxikljlarhkseu.supabase.co https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://www.facebook.com https://connect.facebook.net; frame-src 'self' https://www.googletagmanager.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|avif|gif|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.(woff2|woff|ttf|otf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|jsx|json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/contact/",
      "destination": "/api/contact"
    },
    {
      "source": "/api/brief/",
      "destination": "/api/brief"
    },
    {
      "source": "/api/newsletter/",
      "destination": "/api/newsletter"
    },
    {
      "source": "/api/newsletter/subscribe",
      "destination": "/api/newsletter"
    },
    {
      "source": "/api/newsletter/subscribe/",
      "destination": "/api/newsletter"
    },
    {
      "source": "/blog/:slug((?!.*\\.).+)",
      "destination": "/blog/:slug.html"
    }
  ]
}
